PORT=5000
# Local MongoDB, or your MongoDB Atlas connection string:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/student_registration?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_registration
# Frontend address(es) allowed to call this API, comma separated. Leave empty in development to allow all.
CLIENT_URL=http://localhost:5173
